# Copiar este archivo a .env y completar los valores reales.
# .env NUNCA se sube al repo (ver .gitignore).

# ---------- users-svc ----------
USERS_DB_NAME=users_db
USERS_DB_USER=users_user
USERS_DB_PASSWORD=change-me-users-db-password

# Secreto usado para firmar los JWT que emite users-svc.
# Debe tener al menos 32 caracteres. Generar uno propio, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-secret-min-32-chars
JWT_EXPIRATION_MS=3600000

# ---------- booking-svc (pendiente, agregar cuando se implemente) ----------
